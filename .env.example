# 原生 Python 应用只读取进程环境变量，不自动读取 .env。
# Docker Compose 会读取项目目录的 .env；确认部署方案后再复制并编辑。
# 下项仅用于原生 Python，容器中固定为 /data。
NOTESHUB_DATA_DIR=./data
# 公网 HTTPS 使用 true。仅本机 HTTP 开发时设为 false。
NOTESHUB_COOKIE_SECURE=true

# 以下为 Docker Compose 设置，不包含任何密码。
COMPOSE_PROJECT_NAME=noteshub
NOTESHUB_IMAGE_TAG=local
# 只绑定服务器回环地址，供反向代理访问；不要将 8000 放行到公网。
NOTESHUB_HTTP_PORT=8000
# 只有启用可选 Caddy HTTPS 配置时才需要：实际域名，不带 https:// 或路径。
NOTESHUB_DOMAIN=
